/* ========================================================
   ACCENT COLORS
   Used for active buttons, sliders, text highlights, etc.
   ======================================================== */
@define-color accent_color #{{ .theme.primary_container }}; /* Used for text/border on dark backgrounds */
@define-color accent_bg_color #{{ .theme.primary }}; /* Main solid accent background */
@define-color accent_fg_color #{{ .theme.primary_fg }}; /* Text/icon color drawn on top of the accent_bg_color */

/* ========================================================
   BACKGROUND / WINDOW COLORS
   The main canvas of the application
   ======================================================== */
@define-color window_bg_color #{{ .theme.background }}; /* Main background of the application window */
@define-color window_fg_color #{{ .theme.foreground }}; /* Default text color */
@define-color view_bg_color #{{ .theme.surface }}; /* Background for text views, lists, and canvas areas */
@define-color view_fg_color #{{ .theme.surface_fg }}; /* Text on top of view_bg_color */

/* ========================================================
   HEADER BAR COLORS (Titlebars)
   ======================================================== */
@define-color headerbar_bg_color #{{ .theme.surface }};
@define-color headerbar_fg_color #{{ .theme.surface_fg }};
@define-color headerbar_border_color #{{ .theme.outline_variant }}; /* Divider line below headerbar */
@define-color headerbar_backdrop_color @window_bg_color; /* Headerbar color when window is unfocused */
@define-color headerbar_shade_color rgba({{ template "hex_to_rgba" .theme.shadow_rgba }}); /* Shadows applied to headerbar */

/* ========================================================
   CARDS / DIALOGS / POPOVERS
   ======================================================== */
@define-color card_bg_color #{{ .theme.surface_variant }}; /* Background for grouped lists/cards */
@define-color card_fg_color #{{ .theme.surface_variant_fg }};
@define-color card_shade_color rgba({{ template "hex_to_rgba" .theme.shadow_rgba }}); /* Drop shadow for cards */

@define-color dialog_bg_color #{{ .theme.surface }}; /* Background of popup dialogs */
@define-color dialog_fg_color #{{ .theme.surface_fg }};

@define-color popover_bg_color #{{ .theme.surface_variant }}; /* Background for right-click menus / popovers */
@define-color popover_fg_color #{{ .theme.surface_variant_fg }};

/* ========================================================
   STATE COLORS (Success, Warning, Error, Destructive)
   ======================================================== */
/* Destructive (e.g., "Delete" buttons) */
@define-color destructive_color #{{ .theme.tertiary }};
@define-color destructive_bg_color #{{ .theme.tertiary_container }};
@define-color destructive_fg_color #{{ .theme.tertiary_container_fg }};

/* Success (e.g., "Completed" states) */
@define-color success_color #{{ .theme.brightgreen }};
@define-color success_bg_color #{{ .theme.green }};
@define-color success_fg_color #{{ .theme.white }};

/* Warning (e.g., Warning banners) */
@define-color warning_color #{{ .theme.yellow }};
@define-color warning_bg_color #{{ .theme.brightyellow }};
@define-color warning_fg_color #{{ .theme.black }};

/* Error (e.g., Input field errors) */
@define-color error_color #{{ .theme.error_fg }};
@define-color error_bg_color #{{ .theme.error_container }};
@define-color error_fg_color #{{ .theme.error_container_fg }};

/* ========================================================
   MISC SHADES
   ======================================================== */
@define-color shade_color rgba({{ template "hex_to_rgba" .theme.shadow_rgba }});
@define-color scrollbar_outline_color rgba(0, 0, 0, 0.5);
