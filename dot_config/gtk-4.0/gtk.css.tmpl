/* ========================================================
   ACCENT COLORS
   Used for active buttons, sliders, text highlights, etc.
   ======================================================== */
@define-color accent_color #{{ .theme.main_color_foreground }}; /* Used for text/border on dark backgrounds */
@define-color accent_bg_color #{{ .theme.highlight_background }}; /* Main solid accent background */
@define-color accent_fg_color #{{ .theme.highlight_foreground }}; /* Text/icon color drawn on top of the accent_bg_color */

/* ========================================================
   BACKGROUND / WINDOW COLORS
   The main canvas of the application
   ======================================================== */
@define-color window_bg_color #{{ .theme.background }}; /* Main background of the application window */
@define-color window_fg_color #{{ .theme.foreground }}; /* Default text color */
@define-color view_bg_color #{{ .theme.background }}; /* Background for text views, lists, and canvas areas */
@define-color view_fg_color #{{ .theme.foreground }}; /* Text on top of view_bg_color */

/* ========================================================
   HEADER BAR COLORS (Titlebars)
   ======================================================== */
@define-color headerbar_bg_color #{{ .theme.secondary_background }};
@define-color headerbar_fg_color #{{ .theme.secondary_foreground }};
@define-color headerbar_border_color #{{ .theme.white }}14; /* Divider line below headerbar */
@define-color headerbar_backdrop_color @window_bg_color; /* Headerbar color when window is unfocused */
@define-color headerbar_shade_color rgba(0, 0, 0, 0.36); /* Shadows applied to headerbar */

/* ========================================================
   CARDS / DIALOGS / POPOVERS
   ======================================================== */
@define-color card_bg_color #{{ .theme.white }}14; /* Background for grouped lists/cards */
@define-color card_fg_color #{{ .theme.foreground }};
@define-color card_shade_color rgba(0, 0, 0, 0.36); /* Drop shadow for cards */

@define-color dialog_bg_color #{{ .theme.secondary_background }}; /* Background of popup dialogs */
@define-color dialog_fg_color #{{ .theme.foreground }};

@define-color popover_bg_color #{{ .theme.secondary_background }}; /* Background for right-click menus / popovers */
@define-color popover_fg_color #{{ .theme.foreground }};

/* ========================================================
   STATE COLORS (Success, Warning, Error, Destructive)
   ======================================================== */
/* Destructive (e.g., "Delete" buttons) */
@define-color destructive_color #{{ .theme.brightmagenta }};
@define-color destructive_bg_color #{{ .theme.magenta }};
@define-color destructive_fg_color #{{ .theme.white }};

/* Success (e.g., "Completed" states) */
@define-color success_color #{{ .theme.brightgreen }};
@define-color success_bg_color #{{ .theme.green }};
@define-color success_fg_color #{{ .theme.white }};

/* Warning (e.g., Warning banners) */
@define-color warning_color #{{ .theme.yellow }};
@define-color warning_bg_color #{{ .theme.brightyellow }};
@define-color warning_fg_color #{{ .theme.black }};

/* Error (e.g., Input field errors) */
@define-color error_color #{{ .theme.brightred }};
@define-color error_bg_color #{{ .theme.red }};
@define-color error_fg_color #{{ .theme.white }};

/* ========================================================
   MISC SHADES
   ======================================================== */
@define-color shade_color rgba(0, 0, 0, 0.36);
@define-color scrollbar_outline_color rgba(0, 0, 0, 0.5);
