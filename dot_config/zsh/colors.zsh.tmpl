
zstyle ':completion:*:default' list-colors "${(s.:.)LS_COLORS}ma=38;2;$(_hex_to_sh_rgb {{ .theme.picker_foreground }});48;2;$(_hex_to_sh_rgb {{ .theme.picker_background }})"

export FZF_DEFAULT_OPTS="
  --color=bg+:#{{ .theme.picker_background }},fg+:#{{ .theme.picker_foreground }},pointer:#{{ .theme.main_color_foreground }}
  --height=50%
  --layout=reverse
  --info=inline
  --margin=1
  --tmux top,40%
  --bind 'ctrl-y:execute-silent(printf {} | cut -f 2- | wl-copy --trim-newline)'"

export NEWT_COLORS='
	root=,default
	roottext=brightred,default
	border=gray,black
	window=lightgray,black
	title=white,black
	textbox=lightgray,black
	acttextbox=white,gray
	button=white,gray
	actbutton=brightmagenta,black
	compactbutton=brightmagenta,black
	listbox=lightgray,black
	actlistbox=white,gray
	actsellistbox=white,gray
	checkbox=lightgray,black
	actcheckbox=white,gray
	entry=lightgray,gray
	disentry=gray,black
	label=lightgray,black
	emptyscale=,black
	fullscale=,gray
'
