
layout {
    gaps 0
    center-focused-column "never"
    // always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    border {
        on
        width 3
    }

    shadow {
        on
        softness 10
        spread 1
        // 155 degree rotation
        offset x=4.22618 y=9.06308
    }

    tab-indicator {
        on
        hide-when-single-tab
        place-within-column
        gap -9
        width 6
        length total-proportion=1.0
        position "right"
        gaps-between-tabs 0
        corner-radius 8
    }

    insert-hint {
        on
    }

    struts {
        left 15
        right 15
        top 15
        bottom 15
    }
}

